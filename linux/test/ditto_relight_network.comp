#version 450
#extension GL_EXT_samplerless_texture_functions : require
// Analytic stand-in for a neural edit, independent of the reconstruction filter.
// It deliberately changes two materials differently while leaving the source's fine texture intact.
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform texture2D source;
layout(binding=1,rgba16f) uniform writeonly image2D target;
layout(push_constant) uniform C { uvec2 size; uint identity; } c;
vec3 decode(vec3 x) { return mix(x/12.92,pow(max((x+.055)/1.055,0.0),vec3(2.4)),greaterThan(x,vec3(.04045))); }
vec3 encode(vec3 x) { return mix(12.92*x,1.055*pow(max(x,0.0),vec3(1.0/2.4))-.055,greaterThan(x,vec3(.0031308))); }
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(p,ivec2(c.size)))) return;
    vec4 s=texelFetch(source,p,0);
    vec3 v=decode(s.rgb);
    vec3 gain=v.b>1.5*v.r?vec3(.85,1.05,1.15):vec3(1.15,1.05,.95);
    imageStore(target,p,c.identity!=0u?s:vec4(encode(v*gain),s.a));
}
